# KeyReach Environment Configuration
# Copy this file to .env and fill in your values.
# The tool works WITHOUT any keys — these are optional upgrades.

# ── Logging ──────────────────────────────────────────────────────────────────
KEYREACH_LOG_FILE=app.log        # Path for rotating log file
KEYREACH_LOG_LEVEL=DEBUG         # DEBUG | INFO | WARNING | ERROR

# ── Optional: Jina API Key (higher rate limits) ───────────────────────────────
# Free tier: ~200 requests/day without key
# Get a free key at: https://jina.ai
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional: Twitter/X API Key (for official API instead of Nitter) ─────────
# TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAxxxxxx

# ── Optional: Search Engine API (replace DuckDuckGo scraping) ────────────────
# BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxx
